# Lumina TTS local runtime (Windows)
# Load this file in your shell/session or copy values to your launcher.

# Use Alibaba DashScope cloud backend
TTS_BACKEND=alibaba

# DashScope (set your real key in shell/user env; do not commit secrets)
DASHSCOPE_API_KEY=sk-71e83ab29fa543a6be8edaa13fbd5be5
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_TTS_MODEL=qwen3-tts-vc-2026-01-22
DASHSCOPE_ENROLL_MODEL=qwen-voice-enrollment

# Force single custom cloned profile across all requests
FORCED_VOICE_PROFILE=Mario
VOICE_LIBRARY_DIR=./voice_library

# Keep single-generation concurrency for predictable latency
TTS_MAX_CONCURRENT=1

# Server
HOST=0.0.0.0
PORT=8880
