{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "@shared/*": ["../../packages/shared-types/*"]
    }
  },
  "include": ["*.ts", "tests/**/*", "../../packages/playtest/src/**/*"]
}
