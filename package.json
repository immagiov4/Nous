{
  "name": "nous-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/backend"
  ],
  "scripts": {
    "deps:install": "bun install --frozen-lockfile --force",
    "predev": "bun run scripts/ensure-local-dev-services.ts",
    "doctor": "bun run scripts/doctor.ts",
    "doctor:gate": "bun run scripts/doctor.ts --profile gate",
    "feature-map": "bun run scripts/run-feature-map.ts",
    "gen:favicon": "bun run scripts/generate-favicon-png.ts",
    "dev": "bun run scripts/run-local-dev.ts",
    "dev:frontend": "bun run scripts/free-frontend-port.ts && bun --bun vite --config apps/web/vite.config.ts",
    "dev:backend": "bun run scripts/free-backend-port.ts && bun --watch apps/backend/src/server.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "render:landing-demos": "bun run scripts/render-landing-demos.ts",
    "lint": "bun run lint:types",
    "lint:biome": "biome lint .",
    "lint:frontend": "tsgo --noEmit -p apps/web/tsconfig.json",
    "lint:backend": "tsgo --noEmit -p apps/backend/tsconfig.json",
    "lint:types": "bun run lint:frontend && bun run lint:backend",
    "quality": "bun run lint && bun run check:biome && bun run check:depcruise && bun run check:eslint-react-hooks",
    "gate:checks": "bun run quality && bun run check:fallow",
    "gate": "bun run gate:checks && bun run test",
    "gate:full": "bun run scripts/run-full-quality-gate.ts",
    "gate:ci": "bun run quality && bun run check:fallow:ci && bun run test",
    "check:biome": "biome check .",
    "check:depcruise": "bun run check:depcruise:web && bun run check:depcruise:backend",
    "check:depcruise:backend": "cd apps/backend && dependency-cruiser --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json src",
    "check:depcruise:web": "cd apps/web && dependency-cruiser --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json .",
    "check:eslint-react-hooks": "bun run scripts/run-eslint-react-hooks.ts",
    "check:fallow": "bunx fallow || exit 0",
    "check:fallow:ci": "bun run scripts/check-fallow-regression.ts",
    "save:fallow:baseline": "bun run scripts/save-fallow-baseline.ts",
    "refresh:fallow:baseline": "bun run check:fallow:ci && bun run save:fallow:baseline",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "biome check --write .",
    "sonar:down": "docker compose -f docker-compose.sonarqube.yml down",
    "sonar:logs": "docker compose -f docker-compose.sonarqube.yml logs -f sonarqube",
    "sonar:scan": "bun run scripts/run-sonar-scan.ts",
    "sonar:stop": "docker compose -f docker-compose.sonarqube.yml stop",
    "sonar:up": "bun run scripts/run-sonar-up.ts",
    "supabase:migrate": "supabase db push",
    "supabase:templates:diff": "bun run scripts/sync-supabase-auth-emails.ts",
    "supabase:templates:sync": "bun run scripts/sync-supabase-auth-emails.ts --apply",
    "supabase:typecheck": "supabase gen types typescript --local --schema public > apps/backend/src/supabase/database.types.ts",
    "test": "bun --bun vitest run --config apps/web/vitest.config.ts",
    "test:supabase-contract": "RUN_SUPABASE_LOCAL_TESTS=1 bun --bun vitest run --config apps/web/vitest.config.ts apps/backend/tests/integration/supabaseLocal.integration.test.ts apps/backend/tests/projects/postgresProjectAssetStore.integration.test.ts apps/backend/tests/projects/projectAssetReconciliation.integration.test.ts apps/backend/tests/projects/projectTransaction.integration.test.ts",
    "test:supabase-local": "RUN_SUPABASE_LOCAL_TESTS=1 bun --bun vitest run --config apps/web/vitest.config.ts apps/backend/tests/integration/supabaseLocal.integration.test.ts apps/backend/tests/projects/postgresProjectAssetStore.integration.test.ts apps/backend/tests/projects/projectAssetReconciliation.integration.test.ts apps/backend/tests/projects/projectTransaction.integration.test.ts",
    "test:workflow-postgres": "bun run scripts/run-workflow-postgres-contract.ts full",
    "test:workflow-postgres:critical": "bun run scripts/run-workflow-postgres-contract.ts critical",
    "test:workflow-codex": "bun run scripts/run-real-workflow-provider-tests.ts",
    "test:watch": "bun --bun vitest --config apps/web/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config apps/web/vitest.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.139",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "acorn": "^8.16.0",
    "ai": "^6.0.137",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.38.0",
    "jszip": "3.10.1",
    "lucide-react": "^0.563.0",
    "mermaid": "11.16.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remotion": "4.0.487",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@remotion/cli": "4.0.487",
    "@sonar/scan": "^4.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@typescript/native-preview": "^7.0.0-dev.20260510.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "10.4.21",
    "dependency-cruiser": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.1",
    "postcss": "8.5.6",
    "postgres": "^3.4.9",
    "supabase": "^2.109.1",
    "supertest": "^7.2.2",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.2",
    "yaml": "^2.9.0"
  }
}
