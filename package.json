{
  "name": "nous-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --config apps/web/vite.config.ts",
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:tts": "cd services/tts-server && python -m api.main",
    "setup:tts": "cd services/tts-server && python download_model.py",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "lint": "npm run lint:types",
    "lint:biome": "biome lint .",
    "lint:frontend": "tsc --noEmit -p apps/web/tsconfig.json",
    "lint:backend": "tsc --noEmit -p apps/backend/tsconfig.json",
    "lint:types": "npm run lint:frontend && npm run lint:backend",
    "quality": "npm run lint && npm run check:biome",
    "check:biome": "biome check .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --config apps/web/vitest.config.ts",
    "test:watch": "vitest --config apps/web/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config apps/web/vitest.config.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.139",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ai": "^6.0.137",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "jszip": "3.10.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "supertest": "^7.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.2"
  }
}
