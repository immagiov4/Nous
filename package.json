{
  "name": "nous-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "bun run scripts/ensure-local-dev-services.ts && bun run scripts/kill-dev-servers.ts",
    "gen:favicon": "bun run scripts/generate-favicon-png.ts",
    "dev": "concurrently --kill-others-on-fail \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:frontend": "vite --config apps/web/vite.config.ts",
    "dev:backend": "cd apps/backend && bun run dev",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "render:landing-demos": "bun run scripts/render-landing-demos.ts",
    "concat:landing-demos": "bun run scripts/concat-landing-demo-videos.ts",
    "lint": "npm run lint:types",
    "lint:biome": "biome lint .",
    "lint:frontend": "tsgo --noEmit -p apps/web/tsconfig.json",
    "lint:backend": "tsgo --noEmit -p apps/backend/tsconfig.json",
    "lint:types": "npm run lint:frontend && npm run lint:backend",
    "quality": "npm run lint && npm run check:biome && npm run check:depcruise && npm run check:eslint-react-hooks",
    "gate": "npm run quality && npm run check:fallow && npm run test",
    "gate:ci": "npm run quality && npm run check:fallow:ci && npm run test",
    "check:biome": "biome check .",
    "check:depcruise": "npm run check:depcruise:web && npm run check:depcruise:backend",
    "check:depcruise:backend": "cd apps/backend && dependency-cruiser --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json src",
    "check:depcruise:web": "cd apps/web && dependency-cruiser --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json .",
    "check:eslint-react-hooks": "eslint apps/web --config eslint.config.mjs --max-warnings 0",
    "check:fallow": "npx fallow || exit 0",
    "check:fallow:ci": "npx fallow dead-code --regression-baseline .fallow-baselines/regression.json --fail-on-regression --tolerance 2% || exit 0",
    "check:semgrep": "uvx --from semgrep semgrep scan --config .semgrep/rules --metrics=off .",
    "save:fallow:baseline": "npx fallow --save-regression-baseline .fallow-baselines/regression.json",
    "refresh:fallow:baseline": "npm run save:fallow:baseline && git add .fallow-baselines/regression.json",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "biome check --write .",
    "sonar:bootstrap": "bun run scripts/bootstrap-sonar-local.ts",
    "sonar:down": "docker compose -f docker-compose.sonarqube.yml down",
    "sonar:logs": "docker compose -f docker-compose.sonarqube.yml logs -f sonarqube",
    "sonar:scan": "bun run scripts/run-sonar-scan.ts",
    "sonar:up": "docker compose -f docker-compose.sonarqube.yml up -d",
    "supabase:migrate": "supabase db push",
    "supabase:templates:diff": "bun run scripts/sync-supabase-auth-emails.ts",
    "supabase:templates:sync": "bun run scripts/sync-supabase-auth-emails.ts --apply",
    "supabase:typecheck": "supabase gen types typescript --local --schema public > apps/backend/src/supabase/database.types.ts",
    "test": "bun --bun vitest run --config apps/web/vitest.config.ts",
    "test:supabase-local": "RUN_SUPABASE_LOCAL_TESTS=1 bun --bun vitest run --config apps/web/vitest.config.ts apps/backend/tests/integration/supabaseLocal.integration.test.ts",
    "test:watch": "bun --bun vitest --config apps/web/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config apps/web/vitest.config.ts apps/web/tests"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.139",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ai": "^6.0.137",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.38.0",
    "idb": "^8.0.3",
    "jszip": "3.10.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remotion": "4.0.487",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@remotion/cli": "4.0.487",
    "@resvg/resvg-js": "^2.6.2",
    "@sonar/scan": "^4.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@typescript/native-preview": "^7.0.0-dev.20260510.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "10.4.21",
    "dependency-cruiser": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.1",
    "karpeslop": "^1.0.25",
    "postcss": "8.5.6",
    "supabase": "^2.109.1",
    "supertest": "^7.2.2",
    "tailwindcss": "3.4.17",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.2"
  }
}
