# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional hosted OpenAI provider
OPENAI_API_KEY=

# Optional single-user local Codex provider. Codex owns login and credentials.
CODEX_APP_SERVER_ENABLED=false
# Required when enabled: the sole authenticated Nous user allowed to use the local Codex account.
# CODEX_BINARY=codex
# CODEX_HOME=/absolute/path/to/.codex

# Model Configuration
# Available models: https://openrouter.ai/models
MODEL_FLASH=openai/gpt-5.4-nano
MODEL_REASONING=openai/gpt-5.4-mini
# Semantic ownership is strict: course builds the course, lesson builds every
# quality-sensitive lesson step, research discovers and analyzes sources, and
# context is reserved for contextual chat.
MODEL_COURSE=openai/gpt-5.6-luna
MODEL_LESSON=openai/gpt-5.6-luna
MODEL_CONTEXT=google/gemini-3.1-flash-lite
OPENAI_MODEL_COURSE=gpt-5.6-terra
OPENAI_MODEL_LESSON=gpt-5.6-terra
OPENAI_MODEL_CONTEXT=gpt-5.6-luna
CODEX_MODEL_COURSE=gpt-5.6-luna
CODEX_MODEL_LESSON=gpt-5.6-terra
CODEX_MODEL_CONTEXT=gpt-5.6-luna
# Artifact planning, rendering, and visual review share this dedicated admin slot.
MODEL_ARTIFACT=openai/gpt-5.4-mini
OPENAI_MODEL_ARTIFACT=gpt-5.6-terra
CODEX_MODEL_ARTIFACT=gpt-5.6-terra
MODEL_IMAGE=google/gemini-3.1-flash-lite-image
MODEL_RESEARCH_PLANNER=perplexity/sonar-pro-search
MODEL_RESEARCH_DOSSIER=perplexity/sonar-pro-search
MODEL_TTS=x-ai/grok-voice-tts-1.0
MODEL_STT=nvidia/parakeet-tdt-0.6b-v3
MODEL_STT_FALLBACK=openai/whisper-large-v3-turbo
TTS_VOICE=Ara

# Enables Decodo-only YouTube discovery and transcript-validated lesson clips.
# Embeds use the official player; videos are never downloaded or rehosted.
DECODO_SCRAPING_API_KEY=

# Max Output Tokens (default: 32000)
MAX_OUTPUT_TOKENS=32000

# Server storage and Supabase Auth
AUTH_MODE=supabase
VITE_AUTH_MODE=supabase
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Technical worker-loop parallelism. This is operational tuning, not a product or account limit.
WORKFLOW_RUNTIME_STEP_CONCURRENCY=4
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_SECRET=replace_with_your_local_jwt_secret
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace_with_your_publishable_or_anon_key
# Resend API key used only by the local Supabase CLI Auth container.
# Keep the real value in ignored .env.local; never commit it.
SUPABASE_AUTH_SMTP_PASS=
# Optional real inbox for the opt-in local Magic Link integration test.
SUPABASE_MAGIC_LINK_TEST_EMAIL=

# Server-only GitHub issue delivery for authenticated in-app feedback.
# Fine-grained token scope: this repository only, Issues read/write.
GITHUB_FEEDBACK_REPOSITORY=
GITHUB_FEEDBACK_TOKEN=

# Frontend/backend endpoints
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3301
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=3301
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development also accepts private-network Vite origins on port 5173 for LAN testing.
# Do not expose local-bypass to an untrusted LAN; browser CORS is not backend authentication.
