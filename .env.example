# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Configuration
# Available models: https://openrouter.ai/models
MODEL_FLASH=google/gemini-3-flash-preview
MODEL_REASONING=google/gemini-3-flash-preview
MODEL_RESEARCH_PLANNER=perplexity/sonar-pro-search
MODEL_RESEARCH_DOSSIER=perplexity/sonar-pro-search
MODEL_TTS=openai/gpt-4o-mini-tts-2025-12-15
TTS_VOICE=coral

# Max Output Tokens (default: 32000)
MAX_OUTPUT_TOKENS=32000

# Project sync
# indexeddb = browser-local storage, lan = shared LAN backend storage
PROJECT_REPOSITORY_MODE=indexeddb
VITE_PROJECT_REPOSITORY_MODE=indexeddb
PROJECT_STORAGE_DRIVER=sqlite
PROJECT_SQLITE_PATH=./apps/backend/data/lumina-projects.sqlite
# Local sync development only. Leave unset in deployments without a real auth layer.
LOCAL_AUTH_BYPASS=true
LOCAL_USER_ID=local-user
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development LAN access only. Allows http://10.x.x.x:5173, http://172.16-31.x.x:5173,
# and http://192.168.x.x:5173 origins when the frontend is opened from another device.
CORS_ALLOW_PRIVATE_NETWORK=false
