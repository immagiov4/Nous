## Exactly one profile: managed or self-hosted.
SUPABASE_DEPLOYMENT=managed

NOUS_PUBLIC_URL=https://reader.example.com
NOUS_BACKEND_PUBLIC_URL=https://api.reader.example.com
NOUS_SUPABASE_PUBLIC_URL=https://project.supabase.co
NOUS_SUPABASE_ANON_KEY=replace_with_publishable_or_anon_key

# Managed: fill these from one Supabase project. Self-hosted: `nous setup`
# replaces them from the pinned official bundle without printing the secrets.
SUPABASE_URL=https://project.supabase.co
DATABASE_URL=postgresql://postgres:replace_me@db.example.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_or_secret_key
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Optional when the JWT issuer differs from SUPABASE_URL (for example behind an internal proxy).
SUPABASE_JWT_ISSUER=

OPENROUTER_API_KEY=replace_with_openrouter_key
OPENAI_API_KEY=
# Optional absolute Node executable used by the memory-bounded PDF fallback parser.
PDF_TEXT_FALLBACK_NODE_EXECUTABLE=
# Optional bootstrap defaults. Once saved, the authenticated admin model panel
# is authoritative and can mix providers independently by semantic workload.
MODEL_COURSE=
MODEL_LESSON=
MODEL_CONTEXT=
OPENAI_MODEL_COURSE=
OPENAI_MODEL_LESSON=
OPENAI_MODEL_CONTEXT=
CODEX_MODEL_COURSE=
CODEX_MODEL_LESSON=
CODEX_MODEL_CONTEXT=
# Optional. Set both values to publish and mirror in-app feedback through GitHub Issues.
GITHUB_FEEDBACK_REPOSITORY=
GITHUB_FEEDBACK_TOKEN=
CORS_ALLOWED_ORIGINS=https://reader.example.com

# Enables Decodo-only YouTube discovery and transcript-validated lesson clips.
# Uses privacy-enhanced embeds; no video is downloaded or rehosted. Kept server-side.
DECODO_SCRAPING_API_KEY=

# Optional for a private operator-controlled instance. The Compose wrapper adds
# persistent Codex credentials only when this is true.
CODEX_APP_SERVER_ENABLED=false
CODEX_BINARY=/usr/local/bin/codex
CODEX_HOME=/home/bun/.codex

NOUS_FRONTEND_BIND=127.0.0.1
NOUS_FRONTEND_PORT=8080
NOUS_BACKEND_BIND=127.0.0.1
NOUS_BACKEND_PORT=3301

# Per-machine capacity for simultaneous backup imports. These defaults allow
# two active uploads while serializing the memory-heavy finalization step.
NOUS_BACKEND_MEMORY_LIMIT=2g
NOUS_BACKEND_CPU_LIMIT=2
NOUS_BACKEND_TMPFS_SIZE=1g
PROJECT_IMPORT_ACTIVE_UPLOADS_GLOBAL=2
PROJECT_IMPORT_ACTIVE_UPLOADS_PER_USER=1
PROJECT_IMPORT_REQUESTS_GLOBAL=4
PROJECT_IMPORT_REQUESTS_PER_USER=1
PROJECT_IMPORT_FINALIZATIONS_GLOBAL=1
PROJECT_IMPORT_DIRECT_MAX_BYTES=20000000
PROJECT_IMPORT_MAX_CHUNK_BYTES=16000000
PROJECT_IMPORT_MAX_CHUNK_COUNT=32
PROJECT_IMPORT_MAX_SERIALIZED_BYTES=280000000
PROJECT_IMPORT_REQUEST_TIMEOUT_MS=120000
PROJECT_IMPORT_RECEIVING_TTL_MS=900000
PROJECT_IMPORT_COMPLETED_TTL_MS=600000
PROJECT_IMPORT_CLEANUP_INTERVAL_MS=60000

# Explicit, optional admin bootstrap. Keep these outside shell history.
ADMIN_EMAIL=
ADMIN_PASSWORD=
